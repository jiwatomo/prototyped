# auto: gunakan LLM bila konfigurasi lengkap, selain itu gunakan mock
# llm: coba gunakan LLM; fallback tetap mengikuti AI_FALLBACK_ENABLED
# mock: paksa penggunaan mock untuk pengujian/demo offline
AI_PROVIDER=auto
AI_FALLBACK_ENABLED=true

# Provider netral: adapter awal menggunakan format OpenAI-compatible
AI_API_FORMAT=openai_compatible
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_CHAT_COMPLETIONS_PATH=/chat/completions
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
AI_TEMPERATURE=0.1

# Batas input untuk melindungi biaya dan kestabilan prototipe
AI_MAX_INPUT_CHARS=30000

# Opsional: override database dan origin frontend
# DATABASE_URL=sqlite:///./app.db
# CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# MAX_PDF_BYTES=5000000
# SESSION_TTL_MINUTES=480
